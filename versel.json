{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "python"
    },
    "v1_direct_tools": {
      "root": "versions/v1_direct_tools",
      "runtime": "python"
    },
    "v2_mcp_tools": {
      "root": "versions/v2_mcp_tools",
      "runtime": "python"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}